{
    "name": "custom/jellyfin-session-guard",
    "description": "Servicio independiente para gestionar límites de sesión y restricciones en Jellyfin",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "symfony/yaml": "^7.1",
        "ratchet/pawl": "^0.4.1"
    },
    "autoload": {
        "psr-4": {
            "JellyfinGuard\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
